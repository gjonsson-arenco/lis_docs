":\"11\"}];\n\t\tlet provincias = [{\"C_PROVINCIA\":\"2\",\"D_PROVINCIA\":\"Buenos Aires\"},{\"C_PROVINCIA\":\"3\",\"D_PROVINCIA\":\"Catamarca\"},{\"C_PROVINCIA\":\"6\",\"D_PROVINCIA\":\"Chaco\"},{\"C_PROVINCIA\":\"7\",\"D_PROVINCIA\":\"Chubut\"},{\"C_PROVINCIA\":\"1\",\"D_PROVINCIA\":\"Ciudad Aut\\u00f3noma De Buenos Aires\"},{\"C_PROVINCIA\":\"4\",\"D_PROVINCIA\":\"Cordoba\"},{\"C_PROVINCIA\":\"5\",\"D_PROVINCIA\":\"Corrientes\"},{\"C_PROVINCIA\":\"8\",\"D_PROVINCIA\":\"Entre Rios\"},{\"C_PROVINCIA\":\"9\",\"D_PROVINCIA\":\"Formosa\"},{\"C_PROVINCIA\":\"10\",\"D_PROVINCIA\":\"Jujuy\"},{\"C_PROVINCIA\":\"11\",\"D_PROVINCIA\":\"La Pampa\"},{\"C_PROVINCIA\":\"12\",\"D_PROVINCIA\":\"La Rioja\"},{\"C_PROVINCIA\":\"13\",\"D_PROVINCIA\":\"Mendoza\"},{\"C_PROVINCIA\":\"14\",\"D_PROVINCIA\":\"Misiones\"},{\"C_PROVINCIA\":\"15\",\"D_PROVINCIA\":\"Neuquen\"},{\"C_PROVINCIA\":\"16\",\"D_PROVINCIA\":\"Rio Negro\"},{\"C_PROVINCIA\":\"17\",\"D_PROVINCIA\":\"Salta\"},{\"C_PROVINCIA\":\"18\",\"D_PROVINCIA\":\"San Juan\"},{\"C_PROVINCIA\":\"19\",\"D_PROVINCIA\":\"San Luis\"},{\"C_PROVINCIA\":\"20\",\"D_PROVINCIA\":\"Santa Cruz\"},{\"C_PROVINCIA\":\"21\",\"D_PROVINCIA\":\"Santa Fe\"},{\"C_PROVINCIA\":\"22\",\"D_PROVINCIA\":\"Santiago Del Estero\"},{\"C_PROVINCIA\":\"23\",\"D_PROVINCIA\":\"Tierra Del Fuego\"},{\"C_PROVINCIA\":\"24\",\"D_PROVINCIA\":\"Tucuman\"}];\n        let url_modulos = \"api/mi-cartilla/modulos/\";\n        let url_busqueda = \"api/mi-cartilla/prestadores\";\n        let nro_beneficio = \"14524763570700\";\n\t\tlet afiliado_nombre = \"PEDROZO MIRIAM GISEL\";\n\t</script>\n<!-- CSS File -->\n<link href=\"https://www.pami.org.ar/css/cartillaV2.css?v=1.766\" rel=\"stylesheet\">\n\n<div id=\"cabecera-busqueda\" class=\"container m-b-20 sinpadding padding-sm\">\n    <div class=\"col-md-12 sinpadding\">\n        <h2 class=\"h2_v2\">Mi cartilla médica</h2>\n\t\t<h5 class=\"text-left cyan h5_responsive\"> PEDROZO MIRIAM GISEL </h5>\n\t\t<h3 class=\"h3_v2\">\n\t\t\tBuscá por servicio médico\n\t\t</h3>\n    </div>\n</div>\n\n\n<div id=\"formulario\" class=\"container m-b-30 p-t-10 sinpadding padding-sm\">\n    <div class=\"col-md-12 fondogris radius10 p-t-40 p-b-20 p-l-30 p-r-30 sm-p-l-15 sm-p-r-15\">\n\n        <form>\n\n\t\t\t<div class=\"col-md-12 sinpadding p-b-20\">\n\t\t\t\t<div class=\"col-md-12 sinpadding padding-sm\">\n\t\t\t\t\t<div class=\"form-group selectpickerv2\">\n\t\t\t\t\t\t<label>Seleccioná una categoría*</label><br>\n\n\t\t\t\t\t\t<select id=\"select-categorias\" class=\"selectpicker\" title=\"Seleccioná...\" data-width=\"100%\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<option value=\"3\"> Médica o Médico de Cabecera </option>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<option value=\"1\"> Especialidades Médicas </option>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<option value=\"2\"> Estudios Diagnósticos y Laboratorio </option>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<option value=\"4\"> Internación y Guardia </option>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<option value=\"7\"> Traslados y Urgencias </option>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<option value=\"6\"> Salud Mental </option>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<option value=\"5\"> Odontología </option>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<option value=\"8\"> Oncología </option>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<option value=\"11\"> Oftalmología </option>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<option value=\"10\"> Audífonos </option>\n\t\t\t\t\t\t\t\t\t\t\t\t\t</select>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\n\t\t\t<div class=\"col-md-12 sinpadding p-b-20\">\n\t\t\t\t<div class=\"col-md-12 sinpadding padding-sm\">\n\t\t\t\t\t<div class=\"form-group selectpickerv2 spconbuscador\">\n\t\t\t\t\t\t<label>Seleccioná un servicio médico*</label><br>\n\n\t\t\t\t\t\t<select id=\"select-modulos\" class=\"selectpicker\" title=\"Ingresá...\" data-live-search=\"true\" data-live-search-placeholder=\"Buscar...\" data-width=\"100%\" disabled>\n\t\t\t\t\t\t</select>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\n\t\t\t<div class=\"col-md-12 sinpadding p-b-20\">\n\t\t\t\t<div class=\"col-md-12 sinpadding padding-sm\">\n\t\t\t\t\t<div class=\"form-group selectpickerv2\">\n\t\t\t\t\t\t<label>Seleccioná una provincia<span class=\"requerido-no-capitado\">*</span></label><br>\n\n\t\t\t\t\t\t<select id=\"select-provincias\" class=\"selectpicker\" title=\"Seleccioná...\"  data-live-search=\"true\" data-live-search-placeholder=\"Buscar...\" data-width=\"100%\" disabled>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<option value=\"2\"> Buenos Aires </option>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<option value=\"3\"> Catamarca </option>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<option value=\"6\"> Chaco </option>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<option value=\"7\"> Chubut </option>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<option value=\"1\"> Ciudad Autónoma De Buenos Aires </option>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<option value=\"4\"> Cordoba </option>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<option value=\"5\"> Corrientes </option>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<option value=\"8\"> Entre Rios </option>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<option value=\"9\"> Formosa </option>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<option value=\"10\"> Jujuy </option>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<option value=\"11\"> La Pampa </option>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<option value=\"12\"> La Rioja </option>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<option value=\"13\"> Mendoza </option>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<option value=\"14\"> Misiones </option>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<option value=\"15\"> Neuquen </option>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<option value=\"16\"> Rio Negro </option>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<option value=\"17\"> Salta </option>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<option value=\"18\"> San Juan </option>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<option value=\"19\"> San Luis </option>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<option value=\"20\"> Santa Cruz </option>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<option value=\"21\"> Santa Fe </option>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<option value=\"22\"> Santiago Del Estero </option>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<option value=\"23\"> Tierra Del Fuego </option>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<option value=\"24\"> Tucuman </option>\n\t\t\t\t\t\t\t\t\t\t\t\t\t</select>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\n\t\t\t<div class=\"col-md-12 sinpadding p-b-20\">\n\t\t\t\t<div class=\"col-md-12 sinpadding padding-sm\">\n\t\t\t\t\t<div class=\"form-group selectpickerv2 spconbuscador\">\n\t\t\t\t\t\t<label>Seleccioná una ubicación<span class=\"requerido-no-capitado\">*</span></label><br>\n\n\t\t\t\t\t\t<select id=\"select-departamentos\" class=\"selectpicker\" data-live-search=\"true\" title=\"Ingresá...\" data-live-search=\"true\" data-live-search-placeholder=\"Buscar...\" data-width=\"100%\" disabled>\n\t\t\t\t\t\t</select>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\n        </form>\n\n    </div>\n</div>\n\n\n<div id=\"accion-buscar\" class=\"container m-b-30 sinpadding padding-sm\">\n\t<div class=\"col-md-12 text-right sinpadding p-t-30\">\n\t\t<div class=\"col-md-12 sinpadding p-b-20\">\n\t\t\t<button id=\"btn-buscar\" class=\"boton_accion_azul_v2 sinmargen\" disabled>Buscar</button>\n\t\t</div>\n\t</div>\n</div>\n\n<div id=\"sin-resultados-capitado\" style=\"display: none;\">\n    <div class=\"container m-b-20 p-t-10 sinpadding padding-sm\">\n        <div class=\"col-md-12 sinpadding\">\n\n            <h4 class=\"h4_v2 p-b-20\">Todavía no tenés asignado un/a profesional o centro de salud</h4>\n            <p>\n                Para solicitar la asignación tenés 2 opciones:\n            </p>\n\t\t\t<ul class=\"p-b-40\">\n\t\t\t\t<li>Acercate a una agencia PAMI con turno previo</li>\n\t\t\t\t<li>Hacé el trámite desde nuestra web</li>\n\t\t\t</ul>\n\t\t\t<div class=\"row p-b-20\">\n\t\t\t\t<div class=\"col-12 col-md-4 p-b-20\">\n\t\t\t\t\t<a class=\"boton_accion_blanco_v2 sinmargen\" href=\"https://www.pami.org.ar/mi-cartilla/inicio\">Ir al menú principal</a>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"col-12 col-md-4 p-b-20\">\n\t\t\t\t\t<a class=\"boton_accion_azul_v2 sinmargen\" href=\"https://turnos.pami.org.ar/\">Solicitar un turno para agencia</a>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"col-12 col-md-4 p-b-20\">\n\t\t\t\t\t<a class=\"boton_accion_azul_v2 sinmargen\" href=\"https://www.pami.org.ar/tramites\">Realizar el trámite web</a>\n\t\t\t\t</div>\n\t\t\t</div>\n\n\t\t</div>\n    </div>\n</div>\n\n<div id=\"descarga-nueva-busqueda\" class=\"container sinpadding padding-sm\" style=\"display: none;\">\n    <div class=\"col-md-12 text-right sinpadding p-t-30\">\n\t\t<div class=\"col-lg-5 col-md-6 col-lg-push-2 sinpadding p-b-20\">\n\t\t\t<button id=\"btn-descargar\" class=\"boton_accion_azul_v2 sinmargen\">Descargar resultados en PDF</button>\n\t\t</div>\n        <div class=\"col-lg-5 col-md-6 col-lg-push-2 sinpadding\">\n            <button id=\"btn-nueva-busqueda\" class=\"boton_accion_blanco_v2 sinmargen\">Realizar otra búsqueda</button>\n        </div>\n    </div>\n</div>\n<div id=\"cambiar-profesional\" class=\"container m-b-50 sinpadding padding-sm\" style=\"display: none\">\n\t<b class=\"font30 m-t-50 m-b-30 display-block\">Cambio o asignación de profesional o centro de salud</b>\n    <div class=\"col-md-12 sinpadding\">\n        <p>\n            Para que te reasignemos otro/a profesional o centro de salud <b>hacé el trámite desde nuestra web</b>.\n        </p>\n\t\t<div class=\"col-md-12 text-center sinpadding p-t-30 p-b-30\">\n\t\t\t<a href=\"https://www.pami.org.ar/tramites\" class=\"boton_accion_azul_v2 sinmargen\">Ver detalle del trámite</a>\n\t\t</div>\n        <p>\n            Si querés ver el listado de prestadores disponibles hacé <a class=\"subrayado\" id=\"link-listado-completo\" href=\"#\"><b>click ACÁ</b></a>.\n        </p>\n    </div>\n</div>\n﻿<div id=\"resultados\" style=\"display: none;\">\n\t<div class=\"container m-b-20 sinpadding padding-sm\">\n\t\t<div class=\"col-md-12 sinpadding\">\n\t\t\t<!--<h2 class=\"h2_v2\">Cartilla médica</h2>-->\n\t\t\t<h1 id=\"resultados-titulo\" class=\"h1_v2\">\n\t\t\t\tCardiología\n\t\t\t</h1>\n\t\t\t<div style=\"display: none;\" class=\"warning-mensaje warning-capitado col-md-12 sinpadding fondorojo radius10 padding-10 m-b-20\">\n\t\t\t\t<p class=\"sinmargen\">\n\t\t\t\t\tTenés un/a profesional o centro de salud designado para vos. Para visualizar sus datos, <a href=\"https://www.pami.org.ar/mi-cartilla/login\" class=\"link_gris_v2\">iniciá sesión</a>.\t\t\t\t</p>\n\t\t\t</div>\n\t\t\t<div style=\"display: none;\" class=\"warning-mensaje warning-capitado col-md-12 sinpadding fondoamarillo radius10 padding-10\">\n\t\t\t\t<p class=\"sinmargen\">\n\t\t\t\t\tTodas las prestaciones son gratuitas.\n\t\t\t\t</p>\n\t\t\t</div>\n\t\t\t<div style=\"display: none;\" class=\"warning-mensaje warning-libre-eleccion col-md-12 sinpadding fondoamarillo radius10 padding-10\">\n\t\t\t\t<p class=\"sinmargen\">\n\t\t\t\t\tPara atención con médicas y médicos especialistas y estudio diagnóstico por imágenes necesitás una <b>orden médica electrónica</b>. Todas las prestaciones son gratuitas.\n\t\t\t\t</p>\n\t\t\t</div>\n\t\t\t<div style=\"display: none;\" class=\"warning-mensaje warning-opticas col-md-12 sinpadding fondoamarillo radius10 padding-10\">\n\t\t\t\t<p class=\"sinmargen\">\n\t\t\t\t\tPara solicitar lentes de contacto o anteojos, tenés que presentar junto con la orden médica de tu oftalmóloga/o, tu DNI y credencial PAMI\n\t\t\t\t</p>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n\n\t<div id=\"capitado-asignado\" class=\"container m-b-20 sinpadding padding-sm\" style=\"display: none\">\n\t\t<b class=\"font28\">\n\t\t\tProfesional/es o centro/s de salud asignado/s\n\t\t</b>\n\t</div>\n\n\t<div id=\"resultado-container\" class=\"container m-b-20 sinpadding padding-sm\">\n\n\t\t<div class=\"resultado-card col-md-12 sinpadding sombra radius15 padding-40 padding-xs-18 m-b-20 fondoceleste\">\n\t\t\t<div class=\"col-md-9 sinpadding\">\n\t\t\t\t<h2 class=\"resultado-card--titulo h2_v2 sinmargen p-b-10\">Malena Fallet</h2>\n\t\t\t\t<p class=\"resultado-card--subtitulo\">\n\t\t\t\t\tUnidad asistencial por + salud Dr. Cesar Milstein\n\t\t\t\t</p>\n\t\t\t</div>\n\t\t\t<div class=\"col-md-3 sinpadding hidden-xs hidden-sm\">\n\t\t\t\t<div class=\"col-md-12 sinpadding p-b-20 text-right\">\n\t\t\t\t\t<a href=\"#!\"  target=\"_blank\" class=\"btn-whatsapp boton_accion_whatsapp_sm_v2 sinmargen\"><i class=\"fa fa-whatsapp p-r-10 font30\"></i>Compartir</a>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class=\"col-md-12 sinpadding\">\n\t\t\t\t<ul>\n\t\t\t\t\t<li class=\"resultado-card--direccion p-b-10\">\n\t\t\t\t\t\tAvda. Alte. Brown 240, Capital Federal.\n\t\t\t\t\t</li>\n\t\t\t\t\t<p class=\"resultado-card--telefono\"><i class=\"fa fa-phone cyan p-r-10\"></i><span>4121-0700</span></p>\n\t\t\t\t</ul>\n\t\t\t\t<div class=\"badges-container acordeon p-t-15\">\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class=\"col-md-12 sinpadding p-t-30 hidden-md hidden-lg\">\n\t\t\t\t<div class=\"col-md-12 sinpadding\">\n\t\t\t\t\t<a href=\"#!\"  target=\"_blank\" class=\"btn-whatsapp boton_accion_whatsapp_sm_v2 sinmargen\"><i class=\"fa fa-whatsapp p-r-10 font33\"></i>Compartir</a>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t\t\n\t</div>\n\n\t<div id=\"accion-cambiar-profesional\" class=\"container m-b-30 sinpadding padding-sm\" style=\"display: none;\">\n\t\t<div class=\"col-md-12 text-right sinpadding p-t-30\">\n\t\t\t<div class=\"col-lg-5 col-md-6 col-lg-push-7 col-md-push-6 sinpadding p-b-20\">\n\t\t\t\t<button id=\"btn-cambiar-profesional\" class=\"boton_accion_azul_v2 sinmargen\">Cambiar profesional o centro de salud</button>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</div>\n\n<div id=\"zona-infinite-scroll\" class=\"fa-2x\">\n\t<i id=\"cargando-infinite-scroll\" class=\"fa fa-spinner fa-spin\"></i>\n</div>\n<div id=\"cargando\" class=\"cargando\" style=\"display: none;\">\r\n\t<div class=\"cargando_contenido\">\r\n\t\t<img src=\"https://www.pami.org.ar/imagenes/cargando.s