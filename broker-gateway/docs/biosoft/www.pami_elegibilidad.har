            "size": 5094,
            "mimeType": "application/javascript",
            "text": "let programaticallyScrolling = false;\nlet infiniteScrollObserver;\n\n(function () {\n\n\tfunction showLoading(mensaje) {\n\t\t$('#cargando .cargando_contenido p').html(mensaje || 'Cargando información...');\n\t\t$('#cargando').show();\n\t}\n\n\tfunction scrollTo(elem) {\n\t\tsetTimeout(() => {\n\t\t\tprogramaticallyScrolling = true;\n\t\t\t$('html, body').animate({\n\t\t\t\tscrollTop: elem.offset().top - $('#header').outerHeight()\n\t\t\t}, 400, 'swing', function () {\n\t\t\t\tprogramaticallyScrolling = false;\n\t\t\t});\n\t\t});\n\t}\n\n\t/**\n\t * Método que se encarga de pushear una nueva URL al historial con los parámetros especificados como Query Params\n\t *\n\t * @see https://developer.mozilla.org/en-US/docs/Web/API/History/pushState\n\t */\n\tfunction replaceStateQueryParams(parametros) {\n\t\tconst urlActual = new URL(window.location.href);\n\t\tconst urlNueva = urlActual.origin + urlActual.pathname + '?' + new URLSearchParams(parametros).toString()\n\t\twindow.history.replaceState(parametros, '', urlNueva);\n\t}\n\n\t/**\n\t * Método que se encarga de pushear una nueva URL al historial con los parámetros especificados como Query Params\n\t *\n\t * @see https://developer.mozilla.org/en-US/docs/Web/API/History/pushState\n\t */\n\tfunction getQueryParamsAsObject() {\n\t\tconst urlActual = new URL(window.location.href);\n\t\treturn Object.fromEntries(new URLSearchParams(urlActual.search))\n\t}\n\n\t/**\n\t * Utilidad para ejecutar un callback cuando se llega al final de scroll de los resultados.\n\t * Se asume que existe un <div> con clase \"zona-infinite-scroll\" y contiene un ícono de carga.\n\t * Se puede opcionalmente indicar una condición que debe retornar un booleano para filtrar eventos de scroll.\n\t * El callback pasado por parámetro será invocado con un nuevo callback para ocultar el ícono de carga\n\t */\n\tfunction onInfiniteScroll(callback, condition) {\n\t\tif (infiniteScrollObserver) {\n\t\t\tinfiniteScrollObserver.disconnect();\n\t\t}\n\n\t\tconst masResultadosElem = document.querySelector('#zona-infinite-scroll');\n\n\t\tinfiniteScrollObserver = new IntersectionObserver(entries => {\n\t\t\tif (entries[0].intersectionRatio <= 0) return;\n\n\t\t\t// Si el ícono se está mostrando, no hacer nada para no llamar múltiples veces al callback\n\t\t\tconst cargando = entries[0].target.children[0];\n\t\t\tif (cargando.style.display && cargando.style.display !== 'none') return;\n\n\t\t\tif (!programaticallyScrolling && (!condition || condition())) {\n\t\t\t\tcallback(function () {\n\t\t\t\t\tcargando.style.display = 'none'\n\t\t\t\t});\n\t\t\t}\n\t\t});\n\n\t\tinfiniteScrollObserver.observe(masResultadosElem);\n\n\t\treturn infiniteScrollObserver;\n\t}\n\n\tfunction descargarCartilla(origen, categoria = null, modulo = null, provincia = null,\n\t\t\t\t\t\t\t   departamento = null, busqueda = null, solo_capitados = null, cugeo = null) {\n\t\tshowLoading('Descargando cartilla<br>La cartilla se está descargando. Esto puede tardar un poco...');\n\n\t\tconst form = document.createElement('form');\n\t\tform.id = String(new Date().getTime());\n\t\tform.method = 'POST';\n\t\tform.target = '_blank';\n\t\tform.action = url_absoluta + 'mi-cartilla/descargar-cartilla';\n\t\tconst origenInput = document.createElement('input');\n\t\torigenInput.name = 'origen';\n\t\torigenInput.value = origen;\n\t\tform.appendChild(origenInput);\n\t\tconst provinciaInput = document.createElement('input');\n\t\tprovinciaInput.name = 'provincia';\n\t\tprovinciaInput.value = provincia;\n\t\tform.appendChild(provinciaInput);\n\t\tconst departamentoInput = document.createElement('input');\n\t\tdepartamentoInput.name = 'departamento';\n\t\tdepartamentoInput.value = departamento;\n\t\tform.appendChild(departamentoInput);\n\t\tconst categoriaInput = document.createElement('input');\n\t\tcategoriaInput.name = 'categoria';\n\t\tcategoriaInput.value = categoria;\n\t\tform.appendChild(categoriaInput);\n\t\tconst moduloInput = document.createElement('input');\n\t\tmoduloInput.name = 'modulo';\n\t\tmoduloInput.value = modulo;\n\t\tform.appendChild(moduloInput);\n\t\tconst busquedaInput = document.createElement('input');\n\t\tbusquedaInput.name = 'busqueda';\n\t\tbusquedaInput.value = busqueda;\n\t\tform.appendChild(busquedaInput);\n\t\tconst soloCapitadosInput = document.createElement('input');\n\t\tsoloCapitadosInput.name = 'solo_capitados';\n\t\tsoloCapitadosInput.value = solo_capitados;\n\t\tform.appendChild(soloCapitadosInput);\n\t\tconst cugeoInput = document.createElement('input');\n\t\tcugeoInput.name = 'cugeo';\n\t\tcugeoInput.value = cugeo;\n\t\tform.appendChild(cugeoInput);\n\t\tform.style.visibility = 'hidden';\n\t\tdocument.body.appendChild(form);\n\n\t\tsetTimeout(function () {\n\t\t\tform.submit();\n\t\t}, 500);\n\n\t\t$('#btn-descargar').prop(\"disabled\", true);\n\t\tsetTimeout(function () {\n\t\t\t$(\".cargando\").hide();\n\t\t\t$('#btn-descargar').prop(\"disabled\", false);\n\t\t\t$('#' + form.id).remove();\n\t\t}, 1000);\n\t}\n\n\tfunction esMiCartilla() {\n\t\tconst fragmentos = window.location.pathname.split('/');\n\t\tlet fragmentoComparacion;\n\t\tdo {\n\t\t\tfragmentoComparacion = fragmentos.shift();\n\t\t} while (fragmentoComparacion.length < 2);\n\t\treturn fragmentoComparacion === 'mi-cartilla';\n\t}\n\n\twindow.utilidades = {\n\t\tshowLoading,\n\t\tscrollTo,\n\t\treplaceStateQueryParams,\n\t\tgetQueryParamsAsObject,\n\t\tonInfiniteScroll,\n\t\tdescargarCartilla,\n\t\tesMiCartilla\n\t};\n})();\n"
          },
