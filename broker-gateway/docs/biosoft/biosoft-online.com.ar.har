          "content": {
            "size": 56816,
            "mimeType": "text/css",
            "text": "@charset \"utf-8\";\r\n/* CSS Document */\r\n\r\n/******************************\r\n\r\n[Table of Contents]\r\n\r\n1. Fuentes\r\n2. Body y cosas generales\r\n3. Header\r\n4. Menu\r\n5. Home\r\n6. News\r\n7. Authorization\r\n8. Services\r\n9. Search\r\n10. Informe\r\n11. Footer\r\n\r\n******************************/\r\n\r\n/***********\r\n1. Fuentes\r\n***********/\r\n\r\n@import url('https://fonts.googleapis.com/css?family=Montserrat:300,300i,400,400i,500,500i,600,600i,700,700i,800,900');\r\n\r\n/*********************************\r\n2. Body y cosas generales\r\n*********************************/\r\n\r\n* {\r\n    margin: 0;\r\n    padding: 0;\r\n    -webkit-font-smoothing: antialiased;\r\n    -webkit-text-shadow: rgba(0,0,0,.01) 0 0 1px;\r\n    text-shadow: rgba(0,0,0,.01) 0 0 1px;\r\n}\r\n\r\nbody {\r\n    font-family: 'Montserrat', sans-serif;\r\n    font-size: 14px;\r\n    font-weight: 400;\r\n    background: #FFFFFF;\r\n    /*color: #a5a5a5;*/\r\n    color: black;\r\n    padding-right: 0px!important;\r\n}\r\n\r\ndiv {\r\n    display: block;\r\n    position: relative;\r\n    -webkit-box-sizing: border-box;\r\n    -moz-box-sizing: border-box;\r\n    box-sizing: border-box;\r\n}\r\n\r\nul {\r\n    list-style: none;\r\n    margin-bottom: 0px;\r\n}\r\n\r\np {\r\n    font-family: 'Montserrat', sans-serif;\r\n    font-size: 14px;\r\n    line-height: 2.14;\r\n    font-weight: 400;\r\n    color: #838383;\r\n    -webkit-font-smoothing: antialiased;\r\n    -webkit-text-shadow: rgba(0,0,0,.01) 0 0 1px;\r\n    text-shadow: rgba(0,0,0,.01) 0 0 1px;\r\n}\r\n\r\n    p a {\r\n        display: inline;\r\n        position: relative;\r\n        color: inherit;\r\n        border-bottom: solid 1px #ffa07f;\r\n        -webkit-transition: all 200ms ease;\r\n        -moz-transition: all 200ms ease;\r\n        -ms-transition: all 200ms ease;\r\n        -o-transition: all 200ms ease;\r\n        transition: all 200ms ease;\r\n    }\r\n\r\n    p:last-of-type {\r\n        margin-bottom: 0;\r\n    }\r\n\r\na, a:visited, a:active, a:link {\r\n    text-decoration: none;\r\n    -webkit-font-smoothing: antialiased;\r\n    -webkit-text-shadow: rgba(0,0,0,.01) 0 0 1px;\r\n    text-shadow: rgba(0,0,0,.01) 0 0 1px;\r\n    color: #e0e0e0;\r\n}\r\n\r\na:hover{\r\n    color:#fff;\r\n}\r\n\r\np a:active {\r\n    position: relative;\r\n    color: #FF6347;\r\n}\r\n\r\np a:hover {\r\n    color: #FFFFFF;\r\n    background: #ffa07f;\r\n}\r\n\r\n    p a:hover::after {\r\n        opacity: 0.2;\r\n    }\r\n\r\n::selection {\r\n    background: #E67E22;\r\n    color: #FFFFFF;\r\n}\r\n\r\np::selection {\r\n}\r\n\r\nh1 {\r\n    font-size: 48px;\r\n}\r\n\r\nh2 {\r\n    font-size: 36px;\r\n}\r\n\r\nh3 {\r\n    font-size: 24px;\r\n}\r\n\r\nh4 {\r\n    font-size: 18px;\r\n}\r\n\r\nh5 {\r\n    font-size: 14px;\r\n}\r\n\r\nh1, h2, h3, h4, h5, h6 {\r\n    font-family: 'Montserrat', sans-serif;\r\n    -webkit-font-smoothing: antialiased;\r\n    -webkit-text-shadow: rgba(0,0,0,.01) 0 0 1px;\r\n    text-shadow: rgba(0,0,0,.01) 0 0 1px;\r\n}\r\n\r\n    h1::selection,\r\n    h2::selection,\r\n    h3::selection,\r\n    h4::selection,\r\n    h5::selection,\r\n    h6::selection {\r\n    }\r\n\r\n.form-control {\r\n    color: #db5246;\r\n}\r\n\r\nsection {\r\n    display: block;\r\n    position: relative;\r\n    box-sizing: border-box;\r\n}\r\n\r\n.clear {\r\n    clear: both;\r\n}\r\n\r\n.clearfix::before, .clearfix::after {\r\n    content: \"\";\r\n    display: table;\r\n}\r\n\r\n.clearfix::after {\r\n    clear: both;\r\n}\r\n\r\n.clearfix {\r\n    zoom: 1;\r\n}\r\n\r\n.float_left {\r\n    float: left;\r\n}\r\n\r\n.float_right {\r\n    float: right;\r\n}\r\n\r\n.trans_200 {\r\n    -webkit-transition: all 200ms ease;\r\n    -moz-transition: all 200ms ease;\r\n    -ms-transition: all 200ms ease;\r\n    -o-transition: all 200ms ease;\r\n    transition: all 200ms ease;\r\n}\r\n\r\n.trans_300 {\r\n    -webkit-transition: all 300ms ease;\r\n    -moz-transition: all 300ms ease;\r\n    -ms-transition: all 300ms ease;\r\n    -o-transition: all 300ms ease;\r\n    transition: all 300ms ease;\r\n}\r\n\r\n.trans_400 {\r\n    -webkit-transition: all 400ms ease;\r\n    -moz-transition: all 400ms ease;\r\n    -ms-transition: all 400ms ease;\r\n    -o-transition: all 400ms ease;\r\n    transition: all 400ms ease;\r\n}\r\n\r\n.trans_500 {\r\n    -webkit-transition: all 500ms ease;\r\n    -moz-transition: all 500ms ease;\r\n    -ms-transition: all 500ms ease;\r\n    -o-transition: all 500ms ease;\r\n    transition: all 500ms ease;\r\n}\r\n\r\n.fill_height {\r\n    height: 100%;\r\n}\r\n\r\n.super_container {\r\n    width: 100%;\r\n    /*min-height: 100%;*/\r\n    overflow: hidden;\r\n}\r\n\r\n.prlx_parent {\r\n    overflow: hidden;\r\n}\r\n\r\n.prlx {\r\n    height: 130% !important;\r\n}\r\n\r\n.parallax-window {\r\n    min-height: 400px;\r\n    background: transparent;\r\n}\r\n\r\n.parallax_background {\r\n    position: absolute;\r\n    top: 0;\r\n    left: 0;\r\n    width: 100%;\r\n    height: 50%;\r\n}\r\n\r\n.background_image {\r\n    position: absolute;\r\n    top: 0;\r\n    left: 0;\r\n    width: 100%;\r\n    height: 10%;\r\n    background-repeat: no-repeat;\r\n    background-size: cover;\r\n    background-position: center center;\r\n}\r\n\r\n.nopadding {\r\n    padding: 0px !important;\r\n}\r\n\r\n.button {\r\n    width: 137px;\r\n    height: 54px;\r\n    background: #E67E22;\r\n    overflow: hidden;\r\n}\r\n\r\n    .button a {\r\n        display: block;\r\n        position: relative;\r\n        width: 100%;\r\n        height: 100%;\r\n        text-align: center;\r\n    }\r\n\r\n        .button a span {\r\n            font-size: 11px;\r\n            font-weight: 500;\r\n            color: #FFFFFF;\r\n            line-height: 54px;\r\n            letter-spacing: 0.2em;\r\n            text-transform: uppercase;\r\n            white-space: nowrap;\r\n            -webkit-transition: all 400ms ease;\r\n            -moz-transition: all 400ms ease;\r\n            -ms-transition: all 400ms ease;\r\n            -o-transition: all 400ms ease;\r\n            transition: all 400ms ease;\r\n        }\r\n\r\n            .button a span:first-child {\r\n                position: absolute;\r\n                top: 50%;\r\n                left: 50%;\r\n                -webkit-transform: translate(-50%, -50%);\r\n                -moz-transform: translate(-50%, -50%);\r\n                -ms-transform: translate(-50%, -50%);\r\n                -o-transform: translate(-50%, -50%);\r\n                transform: translate(-50%, -50%);\r\n            }\r\n\r\n            .button a span:last-child {\r\n                position: absolute;\r\n                left: 50%;\r\n                -webkit-transform: translateX(-50%);\r\n                -moz-transform: translateX(-50%);\r\n                -ms-transform: translateX(-50%);\r\n                -o-transform: translateX(-50%);\r\n                transform: translateX(-50%);\r\n                top: 100%;\r\n                font-size: 9px;\r\n                opacity: 0;\r\n            }\r\n\r\n    .button:hover a span:first-child {\r\n        top: -10%;\r\n        font-size: 9px;\r\n        opacity: 0;\r\n    }\r\n\r\n    .button:hover a span:last-child {\r\n        top: 50%;\r\n        -webkit-transform: translate(-50%, -50%);\r\n        -moz-transform: translate(-50%, -50%);\r\n        -ms-transform: translate(-50%, -50%);\r\n        -o-transform: translate(-50%, -50%);\r\n        transform: translate(-50%, -50%);\r\n        font-size: 11px;\r\n        opacity: 1;\r\n    }\r\n\r\n.button_2 {\r\n    background: #FFFFFF;\r\n}\r\n\r\n    .button_2 a span {\r\n        color: #404040;\r\n    }\r\n\r\n.section_title {\r\n    font-size: 2.2rem;\r\n    font-weight: 600;\r\n    color: #404040;\r\n    line-height: 0.75;\r\n}\r\n\r\n.section_subtitle {\r\n    font-size: 11px;\r\n    font-weight: 600;\r\n    color: #838383;\r\n    line-height: 0.75;\r\n    letter-spacing: 0.2em;\r\n    text-transform: uppercase;\r\n    margin-top: 23px;\r\n}\r\n\r\n.alert {\r\n    position: relative;\r\n    padding: 12px 20px;\r\n    padding: .75rem 1.25rem;\r\n    margin-bottom: 16px;\r\n    margin-bottom: 1rem;\r\n    border: 1px solid transparent;\r\n    border-radius: .25rem;\r\n    font-size: .8rem;\r\n}\r\n\r\n.alert-success {\r\n    color: #285b2a;\r\n    background-color: #dbefdc;\r\n    border-color: #cde9ce;\r\n}\r\n\r\n.alert-danger {\r\n    color: #7f231c;\r\n    background-color: #fdd9d7;\r\n    border-color: #fccac7;\r\n}\r\n\r\n.btn-orange {\r\n    color: #fff;\r\n    background-color: #E67E22;\r\n    border-color: #E67E22;\r\n}\r\n\r\n/*********************************\r\n3. Header\r\n*********************************/\r\n\r\n.header {\r\n    position: absolute;\r\n    top: 0;\r\n    left: 0;\r\n    width: 100%;\r\n    background: #FFFFFF;\r\n    z-index: 100;\r\n}\r\n\r\n    .header.scrolled {\r\n        position: fixed;\r\n        top: -91px;\r\n        left: 0;\r\n    }\r\n\r\n.header_top {\r\n    width: 100%;\r\n    z-index: 2;\r\n}\r\n\r\n.header_top_content {\r\n    height: 61px;\r\n    -webkit-transition: all 200ms ease;\r\n    -moz-transition: all 200ms ease;\r\n    -ms-transition: all 200ms ease;\r\n    -o-transition: all 200ms ease;\r\n    transition: all 200ms ease;\r\n}\r\n\r\n.logo a {\r\n    line-height: 0.75;\r\n    color: #404040;\r\n    font-size: 1.5rem;\r\n    font-weight: 700;\r\n    text-transform: uppercase;\r\n}\r\n\r\n    .logo a span {\r\n        position: relative;\r\n        font-size: 36px;\r\n        color: #E67E22;\r\n        line-height: 0.75;\r\n        vertical-align: text-top;\r\n    }\r\n\r\n.header_top_nav ul li {\r\n    position: relative;\r\n}\r\n\r\n    .header_top_nav ul li:not(:last-child)::after {\r\n        content: '|';\r\n        margin-left: 12px;\r\n        margin-right: 12px;\r\n    }\r\n\r\n    .header_top_nav ul li a {\r\n        font-size: 14px;\r\n        font-weight: 500;\r\n        color: #838383;\r\n        -webkit-transition: all 200ms ease;\r\n        -moz-transition: all 200ms ease;\r\n        -ms-transition: all 200ms ease;\r\n        -o-transition: all 200ms ease;\r\n        transition: all 200ms ease;\r\n    }\r\n\r\n        .header_top_nav ul li a:hover {\r\n            color: #E67E22;\r\n        }\r\n\r\n.header_top_phone {\r\n    margin-left: 44px;\r\n}\r\n\r\n    .header_top_phone i {\r\n        font-size: 1rem;\r\n        color: #E67E22;\r\n        vertical-align: middle;\r\n        transform: translateY(-1px);\r\n    }\r\n\r\n    .header_top_phone span {\r\n        font-size: 0.8rem;\r\n        font-weight: 600;\r\n        color: #404040;\r\n        margin-left: 3px;\r\n        vertical-align: middle;\r\n    }\r\n\r\n.hamburger {\r\n    display: none;\r\n    cursor: pointer;\r\n}\r\n\r\n    .hamburger i {\r\n        font-size: 18px;\r\n        color: #4c4c4c;\r\n        -webkit-transition: all 200ms ease;\r\n        -moz-transition: all 200ms ease;\r\n        -ms-transition: all 200ms ease;\r\n        -o-transition: all 200ms ease;\r\n        transition: all 200ms ease;\r\n    }\r\n\r\n        .hamburger i:hover {\r\n            color: #329fec;\r\n        }\r\n\r\n.header_nav {\r\n    z-index: 2;\r\n}\r\n\r\n.header_nav_inner {\r\n    width: 100%;\r\n}\r\n\r\n.header_nav_container {\r\n    z-index: 1;\r\n    background: #E67E22;\r\n}\r\n\r\n.header_nav_content {\r\n    height: 4rem;\r\n}\r\n\r\n.main_nav {\r\n    height: 100%;\r\n}\r\n\r\n    .main_nav ul {\r\n        height: 100%;\r\n    }\r\n\r\n        .main_nav ul li {\r\n            position: relative;\r\n        }\r\n\r\n            .main_nav ul li:not(:last-child) {\r\n                margin-right: 70px;\r\n            }\r\n\r\n            .main_nav ul li a {\r\n                display: block;\r\n                position: relative;\r\n                height: 100%;\r\n                font-size: 13px;\r\n                font-weight: 600;\r\n                color: #FFFFFF;\r\n                z-index: 1;\r\n                text-transform: uppercase;\r\n                -webkit-transition: all 200ms ease;\r\n                -moz-transition: all 200ms ease;\r\n                -ms-transition: all 200ms ease;\r\n                -o-transition: all 200ms ease;\r\n                transition: all 200ms ease;\r\n            }\r\n\r\n                .main_nav ul li a:hover,\r\n                .main_nav ul li.active a {\r\n                    color: rgba(255,255,255,0.75);\r\n                }\r\n\r\n.search_content {\r\n    height: 60px;\r\n}\r\n\r\n.search_container_form {\r\n    position: relative;\r\n    width: 337px;\r\n}\r\n\r\n.search_container_input {\r\n    width: 100%;\r\n    height: 37px;\r\n    border: none;\r\n    outline: none;\r\n    padding-left: 20px;\r\n}\r\n\r\n    .search_container_input::-webkit-input-placeholder {\r\n        font-size: 12px !important;\r\n        font-weight: 400 !important;\r\n        font-style: italic;\r\n        color: #ababab !important;\r\n    }\r\n\r\n    .search_container_input:-moz-placeholder {\r\n        font-size: 12px !important;\r\n        font-weight: 400 !important;\r\n        font-style: italic;\r\n        color: #ababab !important;\r\n    }\r\n\r\n    .search_container_input::-moz-placeholder {\r\n        font-size: 12px !important;\r\n        font-weight: 400 !important;\r\n        font-style: italic;\r\n        color: #ababab !important;\r\n    }\r\n\r\n    .search_container_input:-ms-input-placeholder {\r\n        font-size: 12px !important;\r\n        font-weight: 400 !important;\r\n        font-style: italic;\r\n        color: #ababab !important;\r\n    }\r\n\r\n    .search_container_input::input-placeholder {\r\n        font-size: 12px !important;\r\n        font-weight: 400 !important;\r\n        font-style: italic;\r\n        color: #ababab !important;\r\n    }\r\n\r\n.search_container_button {\r\n    position: absolute;\r\n    top: 0;\r\n    right: 0;\r\n    width: 37px;\r\n    height: 37px;\r\n    border: none;\r\n    outline: none;\r\n    cursor: pointer;\r\n    background: #FFFFFF;\r\n}\r\n\r\n.header_search {\r\n    display: inline-block;\r\n    vertical-align: middle;\r\n    padding: 10px;\r\n    cursor: pointer;\r\n}\r\n\r\n    .header_search i {\r\n        color: #4c4c4c;\r\n        -webkit-transition: all 200ms ease;\r\n        -moz-transition: all 200ms ease;\r\n        -ms-transition: all 200ms ease;\r\n        -o-transition: all 200ms ease;\r\n        transition: all 200ms ease;\r\n    }\r\n\r\n    .header_search:hover i {\r\n        color: #329fec;\r\n    }\r\n\r\n/*********************************\r\n4. Menu\r\n*********************************/\r\n\r\n.menu {\r\n    position: fixed;\r\n    width: 100vw;\r\n    height: 100vh;\r\n    background: #E67E22;\r\n    z-index: 101;\r\n    opacity: 0;\r\n    visibility: hidden;\r\n}\r\n\r\n    .menu.active {\r\n        opacity: 0.98;\r\n        visibility: visible;\r\n    }\r\n\r\n.menu_content {\r\n    width: 100%;\r\n    height: 100%;\r\n}\r\n\r\n    .menu_content ul {\r\n        margin-top: 40px;\r\n    }\r\n\r\n.menu_item {\r\n    position: relative;\r\n    margin-bottom: 3px;\r\n}\r\n\r\n    .menu_item:last-child {\r\n        margin-bottom: 0px;\r\n    }\r\n\r\n    .menu_item a {\r\n        display: inline-block;\r\n        position: relative;\r\n        font-size: 36px;\r\n        color: #FFFFFF;\r\n        font-weight: 600;\r\n    }\r\n\r\n        /*.menu_item a::after {\r\n            display: block;\r\n            position: absolute;\r\n            top: 52%;\r\n            left: 0;\r\n            width: 0;\r\n            height: 4px;\r\n            background: #FFFFFF;\r\n            letter-spacing: 2px;\r\n            content: '';\r\n            z-index: 10;\r\n            pointer-events: none;\r\n            -webkit-transition: all 200ms ease;\r\n            -moz-transition: all 200ms ease;\r\n            -ms-transition: all 200ms ease;\r\n            -o-transition: all 200ms ease;\r\n            transition: all 400ms ease;\r\n        }*/\r\n\r\n    .menu_item:hover a::after {\r\n        width: 100%;\r\n    }\r\n\r\n.menu_close_container {\r\n    position: absolute;\r\n    top: 94px;\r\n    right: 122px;\r\n    width: 21px;\r\n    height: 21px;\r\n    cursor: pointer;\r\n    -webkit-transform: rotate(45deg);\r\n    -moz-transform: rotate(45deg);\r\n    -ms-transform: rotate(45deg);\r\n    -o-transform: rotate(45deg);\r\n    transform: rotate(45deg);\r\n}\r\n\r\n.menu_close {\r\n    top: 9px;\r\n    width: 21px;\r\n    height: 3px;\r\n    background: #FFFFFF;\r\n    -webkit-transition: all 200ms ease;\r\n    -moz-transition: all 200ms ease;\r\n    -ms-transition: all 200ms ease;\r\n    -o-transition: all 200ms ease;\r\n    transition: all 200ms ease;\r\n}\r\n\r\n    .menu_close::after {\r\n        display: block;\r\n        position: absolute;\r\n        top: -9px;\r\n        left: 9px;\r\n        content: '';\r\n        width: 3px;\r\n        height: 21px;\r\n        background: #FFFFFF;\r\n        -webkit-transition: all 200ms ease;\r\n        -moz-transition: all 200ms ease;\r\n        -ms-transition: all 200ms ease;\r\n        -o-transition: all 200ms ease;\r\n        transition: all 200ms ease;\r\n    }\r\n\r\n.menu_close_container:hover .menu_close,\r\n.menu_close_container:hover .menu_close::after {\r\n    background: rgba(255,255,255,0.7);\r\n}\r\n\r\n.menu_search_form {\r\n    position: relative;\r\n    width: 300px;\r\n}\r\n\r\n.menu_search_input {\r\n    width: 100%;\r\n    height: 40px;\r\n    background: rgba(255,255,255,0.9);\r\n    border: none;\r\n    outline: none;\r\n    padding-left: 20px;\r\n}\r\n\r\n    .menu_search_input::-webkit-input-placeholder {\r\n        font-size: 12px !important;\r\n        font-weight: 400 !important;\r\n        font-style: italic;\r\n        color: #ababab !important;\r\n    }\r\n\r\n    .menu_search_input:-moz-placeholder {\r\n        font-size: 12px !important;\r\n        font-weight: 400 !important;\r\n        font-style: italic;\r\n        color: #ababab !important;\r\n    }\r\n\r\n    .menu_search_input::-moz-placeholder {\r\n        font-size: 12px !important;\r\n        font-weight: 400 !important;\r\n        font-style: italic;\r\n        color: #ababab !important;\r\n    }\r\n\r\n    .menu_search_input:-ms-input-placeholder {\r\n        font-size: 12px !important;\r\n        font-weight: 400 !important;\r\n        font-style: italic;\r\n        color: #ababab !important;\r\n    }\r\n\r\n    .menu_search_input::input-placeholder {\r\n        font-size: 12px !important;\r\n        font-weight: 400 !important;\r\n        font-style: italic;\r\n        color: #ababab !important;\r\n    }\r\n\r\n.menu_search_button {\r\n    position: absolute;\r\n    top: 0;\r\n    right: 0;\r\n    width: 40px;\r\n    height: 40px;\r\n    background: transparent;\r\n    border: none;\r\n    outline: none;\r\n}\r\n\r\n.menu_social {\r\n    position: absolute;\r\n    left: 50%;\r\n    -webkit-transform: translateX(-50%);\r\n    -moz-transform: translateX(-50%);\r\n    -ms-transform: translateX(-50%);\r\n    -o-transform: translateX(-50%);\r\n    transform: translateX(-50%);\r\n    bottom: 15px;\r\n}\r\n\r\n    .menu_social ul {\r\n        display: inline-block;\r\n        margin-left: 25px;\r\n        white-space: nowrap;\r\n    }\r\n\r\n        .menu_social ul li {\r\n            display: inline-block;\r\n        }\r\n\r\n            .menu_social ul li:not(:last-child) {\r\n                margin-right: 15px;\r\n            }\r\n\r\n            .menu_social ul li a i {\r\n                color: rgba(255,255,255,0.7);\r\n                -webkit-transition: all 200ms ease;\r\n                -moz-transition: all 200ms ease;\r\n                -ms-transition: all 200ms ease;\r\n                -o-transition: all 200ms ease;\r\n                transition: all 200ms ease;\r\n                padding: 5px;\r\n            }\r\n\r\n                .menu_social ul li a i:hover {\r\n                    color: rgba(255,255,255,1);\r\n                }\r\n\r\n.dropdown-menu {\r\n    background: #E67E22;\r\n}\r\n\r\n.dropdown-item:hover {\r\n    background: white !important;\r\n    color: #E67E22 !important;\r\n}\r\n\r\n/*********************************\r\n5. Home\r\n*********************************/\r\n\r\n.home {\r\n    width: 100%;\r\n    height: 252px;\r\n}\r\n\r\n.home_container {\r\n    position: absolute;\r\n    bottom: 50px;\r\n    left: 0;\r\n    width: 100%;\r\n}\r\n\r\n.home_content {\r\n}\r\n\r\n.home_title {\r\n    display: inline-block;\r\n    height: 3rem;\r\n    font-size: 2.5rem;\r\n    font-weight: 600;\r\n    line-height: 54px;\r\n    text-align: center;\r\n    color: #FFFFFF;\r\n    background: #E67E22;\r\n    padding-left: 17px;\r\n    padding-right: 19px;\r\n}\r\n\r\n/*********************************\r\n6. News\r\n*********************************/\r\n.news {\r\n    width: 100%;\r\n    background: #FFFFFF;\r\n    padding-top: 50px;\r\n    padding-bottom: 100px;    \r\n    /*min-height: 50%;*/\r\n}\r\n\r\n.news_post:not(:last-child) {\r\n    margin-bottom: 13px;\r\n}\r\n\r\n.news_post_image {\r\n    width: 100%;\r\n}\r\n\r\n    .news_post_image img {\r\n        max-width: 100%;\r\n    }\r\n\r\n.news_post_content {\r\n    padding-top: 36px;\r\n}\r\n\r\n.news_post_date {\r\n    width: 150px;\r\n    height: 31px;\r\n    text-align: center;\r\n    background: #E67E22;\r\n}\r\n\r\n    .news_post_date span {\r\n        display: block;\r\n        line-height: 31px;\r\n        font-size: 0.8rem;\r\n        font-weight: 500;\r\n        color: #FFFFFF;\r\n        padding: 0px 10px;\r\n    }\r\n\r\n.news_post_title {\r\n    margin-top: 15px;\r\n}\r\n\r\n    .news_post_title span {\r\n        font-size: 1.5rem;\r\n        font-weight: 600;\r\n        color: #404040;\r\n        line-height: 1.2;\r\n        -webkit-transition: all 200ms ease;\r\n        -moz-transition: all 200ms ease;\r\n        -ms-transition: all 200ms ease;\r\n        -o-transition: all 200ms ease;\r\n        transition: all 200ms ease;\r\n    }\r\n\r\n        .news_post_title span:hover {\r\n            color: #E67E22;\r\n        }\r\n\r\n.news_post_info {\r\n    margin-top: 7px;\r\n}\r\n\r\n    .news_post_info ul li {\r\n        position: relative;\r\n    }\r\n\r\n        .news_post_info ul li::after {\r\n            content: '/';\r\n            margin-left: 4px;\r\n            margin-right: 3px;\r\n            font-size: 11px;\r\n            font-weight: 500;\r\n            color: #838383;\r\n        }\r\n\r\n        .news_post_info ul li a {\r\n            font-size: 12px;\r\n            font-weight: 500;\r\n            color: #838383;\r\n        }\r\n\r\n.news_post_text {\r\n    margin-top: 15px;\r\n}\r\n\r\n    .news_post_text p {\r\n        font-size: 0.9rem;\r\n        color: black;\r\n    }\r\n\r\n.news_post_button {\r\n    margin-top: 34px;\r\n}\r\n\r\n.pagination ul li {\r\n    width: 35px;\r\n    height: 35px;\r\n    background: transparent;\r\n    text-align: center;\r\n}\r\n\r\n    .pagination ul li.active {\r\n        background: #E67E22;\r\n    }\r\n\r\n    .pagination ul li:not(:last-child) {\r\n        margin-right: 8px;\r\n    }\r\n\r\n    .pagination ul li a {\r\n        display: block;\r\n        font-size: 16px;\r\n        font-weight: 500;\r\n        color: #404040;\r\n        line-height: 35px;\r\n    }\r\n\r\n    .pagination ul li.active a {\r\n        color: #FFFFFF;\r\n    }\r\n\r\n.news_sidebar {\r\n    width: 100%;\r\n}\r\n\r\n.sidebar_search_input {\r\n    width: 100%;\r\n    height: 37px;\r\n    border: none;\r\n    outline: none;\r\n    background: #e5ecf1;\r\n    padding-left: 20px;\r\n}\r\n\r\n.sidebar_search_button {\r\n    position: absolute;\r\n    top: 0;\r\n    right: 0;\r\n    width: 37px;\r\n    height: 100%;\r\n    background: transparent;\r\n    border: none;\r\n    outline: none;\r\n    cursor: pointer;\r\n}\r\n\r\n.sidebar_search_input::-webkit-input-placeholder {\r\n    font-size: 12px !important;\r\n    font-weight: 500 !important;\r\n    font-style: italic;\r\n    color: #ababab !important;\r\n}\r\n\r\n.sidebar_search_input:-moz-placeholder {\r\n    font-size: 12px !important;\r\n    font-weight: 500 !important;\r\n    font-style: italic;\r\n    color: #ababab !important;\r\n}\r\n\r\n.sidebar_search_input::-moz-placeholder {\r\n    font-size: 12px !important;\r\n    font-weight: 500 !important;\r\n    font-style: italic;\r\n    color: #ababab !important;\r\n}\r\n\r\n.sidebar_search_input:-ms-input-placeholder {\r\n    font-size: 12px !important;\r\n    font-weight: 500 !important;\r\n    font-style: italic;\r\n    color: #ababab !important;\r\n}\r\n\r\n.sidebar_search_input::input-placeholder {\r\n    font-size: 12px !important;\r\n    font-weight: 500 !important;\r\n    font-style: italic;\r\n    color: #ababab !important;\r\n}\r\n\r\n.sidebar_latest {\r\n    margin-top: 58px;\r\n}\r\n\r\n.sidebar_title {\r\n    font-size: 24px;\r\n    font-weight: 600;\r\n    color: #404040;\r\n    line-height: 1.2;\r\n}\r\n\r\n.sidebar_latest_container {\r\n    margin-top: 37px;\r\n}\r\n\r\n.latest:not(:last-child) {\r\n    margin-bottom: 23px;\r\n}\r\n\r\n.latest_image {\r\n    width: 73px;\r\n    height: 73px;\r\n}\r\n\r\n    .latest_image img {\r\n        max-width: 100%;\r\n    }\r\n\r\n.latest_content {\r\n    padding-left: 25px;\r\n}\r\n\r\n.latest_title {\r\n    margin-top: -3px;\r\n}\r\n\r\n    .latest_title a {\r\n        font-size: 16px;\r\n        font-weight: 500;\r\n        color: #404040;\r\n        -webkit-transition: all 200ms ease;\r\n        -moz-transition: all 200ms ease;\r\n        -ms-transition: all 200ms ease;\r\n        -o-transition: all 200ms ease;\r\n        transition: all 200ms ease;\r\n    }\r\n\r\n        .latest_title a:hover {\r\n            color: #E67E22;\r\n        }\r\n\r\n.latest_info {\r\n    margin-top: 1px;\r\n}\r\n\r\n    .latest_info ul li {\r\n        position: relative;\r\n    }\r\n\r\n        .latest_info ul li:not(:last-child)::after {\r\n            content: '/';\r\n            margin-left: 3px;\r\n            margin-right: 2px;\r\n            font-size: 12px;\r\n            font-weight: 500;\r\n            color: #838383;\r\n        }\r\n\r\n        .latest_info ul li a {\r\n            font-size: 12px;\r\n            font-weight: 500;\r\n            color: #838383;\r\n            -webkit-transition: all 200ms ease;\r\n            -moz-transition: all 200ms ease;\r\n            -ms-transition: all 200ms ease;\r\n            -o-transition: all 200ms ease;\r\n            transition: all 200ms ease;\r\n        }\r\n\r\n            .latest_info ul li a:hover {\r\n                color: #E67E22;\r\n            }\r\n\r\n.latest_comments {\r\n    margin-top: 6px;\r\n}\r\n\r\n    .latest_comments a {\r\n        font-size: 12px;\r\n        font-weight: 500;\r\n        color: #E67E22;\r\n    }\r\n\r\n.sidebar_categories {\r\n    margin-top: 60px;\r\n}\r\n\r\n.categories {\r\n    background: white;\r\n    padding-left: 17px;\r\n    /*padding-top: 37px;*/\r\n    padding-right: 26px;\r\n    padding-bottom: 37px;\r\n    /*margin-top: 44px;*/\r\n    width: 100%;\r\n    color: black;\r\n}\r\n\r\n    .categories ul li:not(:first-child) {\r\n        margin-top: -4px;\r\n    }\r\n\r\n       \r\n\r\n    .categories ul li a > div {\r\n        width: 100%;\r\n        height: 44px;\r\n        /*padding-right: 22px;*/\r\n        /*padding-left: 15px;*/\r\n        -webkit-transition: all 200ms ease;\r\n        -moz-transition: all 200ms ease;\r\n        -ms-transition: all 200ms ease;\r\n        -o-transition: all 200ms ease;\r\n        transition: all 200ms ease;\r\n        margin-bottom: 15px;\r\n        border-bottom: #E67E22 2px solid;\r\n    }\r\n\r\n        .categories ul li a > div > div {\r\n            font-size: 12px;\r\n            font-weight: 500;\r\n            color: black;\r\n            -webkit-transition: all 200ms ease;\r\n            -moz-transition: all 200ms ease;\r\n            -ms-transition: all 200ms ease;\r\n            -o-transition: all 200ms ease;\r\n            transition: all 200ms ease;\r\n        }\r\n\r\n    .categories ul li:hover a > div {\r\n        background: #E67E22;\r\n       \r\n    }\r\n\r\n        .categories ul li:hover a > div > div {\r\n            color: #fff;\r\n        }\r\n\r\n.gv- bs {\r\n    border-color: #e5ecf1;\r\n    padding-left: 10px;\r\n}\r\n\r\n.gv-hs {\r\n    -webkit-transition: all 200ms ease;\r\n    -moz-transition: all 200ms ease;\r\n    -ms-transition: all 200ms ease;\r\n    -o-transition: all 200ms ease;\r\n    transition: all 200ms ease;\r\n    border-right: hidden;\r\n    color: #e9ecef;\r\n    border-bottom: #E67E22 2px solid;\r\n}\r\n\r\n    .gv-hs th {\r\n        color: black !important;\r\n        font-size: 0.9rem !important;\r\n        font-weight: 700 !important;\r\n        text-align: left !important;\r\n        padding-left: 0.5rem !important;\r\n        border-right: hidden !important;\r\n        border-color: #e5ecf1 !important;\r\n    }\r\n\r\n.gv-rs {\r\n    font-size: 12px;\r\n    font-weight: 500;\r\n    color: #e9ecef;\r\n    -webkit-transition: all 200ms ease;\r\n    -moz-transition: all 200ms ease;\r\n    -ms-transition: all 200ms ease;\r\n    -o-transition: all 200ms ease;\r\n    transition: all 200ms ease;\r\n    border-bottom: #E67E22 2px solid;\r\n}\r\n\r\n    .gv-rs td {\r\n        color: black !important;\r\n        font-size: 0.8rem !important;\r\n        text-align: left !important;\r\n        padding-left: 0.5rem !important;\r\n        border-right: hidden !important;\r\n        border-color: #e5ecf1 !important;\r\n    }\r\n\r\n.info_form_container {\r\n    width: 100%;\r\n    background: #e5ecf1;\r\n    height: 100%;\r\n    padding-left: 20px;\r\n    padding-top: 50px;\r\n    padding-bottom: 54px;\r\n    margin-top: 64px;\r\n}\r\n\r\n.info_form_title {\r\n    font-size: 24px;\r\n    font-weight: 600;\r\n    color: #404040;\r\n    line-height: 1.2;\r\n}\r\n\r\n.info_form {\r\n    width: 100%;\r\n    padding-right: 20px;\r\n    margin-top: 43px;\r\n}\r\n\r\n    .info_form select {\r\n        margin-bottom: 26px;\r\n    }\r\n\r\n    .info_form input:not(:last-child) {\r\n        margin-bottom: 23px;\r\n    }\r\n\r\n.info_input {\r\n    display: block;\r\n    position: relative;\r\n    width: 100%;\r\n    height: 2.5rem;\r\n    background: #FFFFFF;\r\n    padding-left: 20px;\r\n    border: none;\r\n    outline: none;\r\n}\r\n\r\n    .info_input::-webkit-input-placeholder {\r\n        font-size: 12px !important;\r\n        font-weight: 500 !important;\r\n        font-style: italic;\r\n        color: #828282 !important;\r\n    }\r\n\r\n    .info_input:-moz-placeholder {\r\n        font-size: 12px !important;\r\n        font-weight: 500 !important;\r\n        font-style: italic;\r\n        color: #828282 !important;\r\n    }\r\n\r\n    .info_input::-moz-placeholder {\r\n        font-size: 12px !important;\r\n        font-weight: 500 !important;\r\n        font-style: italic;\r\n        color: #828282 !important;\r\n    }\r\n\r\n    .info_input:-ms-input-placeholder {\r\n        font-size: 12px !important;\r\n        font-weight: 500 !important;\r\n        font-style: italic;\r\n        color: #828282 !important;\r\n    }\r\n\r\n    .info_input::input-placeholder {\r\n        font-size: 12px !important;\r\n        font-weight: 500 !important;\r\n        font-style: italic;\r\n        color: #828282 !important;\r\n    }\r\n\r\n.info_select {\r\n    display: block;\r\n    position: relative;\r\n    -webkit-appearance: none;\r\n    -moz-appearance: none;\r\n    -ms-appearance: none;\r\n    -o-appearance: none;\r\n    appearance: none;\r\n    -webkit-box-shadow: 0px 0px 0px rgba(0, 0, 0, 0);\r\n    -webkit-user-select: none;\r\n    background-image: url(../images/down.png);\r\n    background-position: center right;\r\n    background-repeat: no-repeat;\r\n    border: none;\r\n    outline: none;\r\n    font-size: 12px !important;\r\n    font-weight: 500 !important;\r\n    font-style: italic;\r\n    color: #828282 !important;\r\n    cursor: pointer;\r\n}\r\n\r\n.info_form_button {\r\n    width: 100%;\r\n    height: 54px;\r\n    background: #E67E22;\r\n    border: none;\r\n    outline: none;\r\n    color: #FFFFFF;\r\n    text-transform: uppercase;\r\n    font-size: 11px;\r\n    font-weight: 600;\r\n    letter-spacing: 0.2em;\r\n    margin-top: 4px;\r\n    cursor: pointer;\r\n}\r\n\r\n/*********************************\r\n7. Autho\r\n*********************************/\r\n\r\n.autho {\r\n    width: 100%;\r\n    background: #FFFFFF;\r\n     padding-top: 12px; \r\n    /*padding-bottom: 0px;*/\r\n    z-index: 2;\r\n    /*min-height: 530px;*/\r\n}\r\n\r\n.autho_title {\r\n    font-size: 24px;\r\n    font-weight: 600;\r\n    color: #404040;\r\n    line-height: 0.75;\r\n}\r\n\r\n.autho_form_container {\r\n    margin-top: 11px;\r\n}\r\n\r\n.autho_form input:not(:last-child) {\r\n    /*margin-bottom: 25px;*/\r\n}\r\n\r\n.autho_input {\r\n    display: block;\r\n    width: 100%;\r\n    height: 2.5rem;\r\n    font-size: 0.8rem;\r\n    background: #e5ecf1;\r\n    border: none;\r\n    outline: none;\r\n    border-left: solid 3px transparent;\r\n    padding-left: 35px;\r\n    -webkit-transition: all 200ms ease;\r\n    -moz-transition: all 200ms ease;\r\n    -ms-transition: all 200ms ease;\r\n    -o-transition: all 200ms ease;\r\n    transition: all 200ms ease;\r\n}\r\n\r\n    .autho_input:focus,\r\n    .autho_input:hover {\r\n        border-left: solid 3px #E67E22;\r\n    }\r\n\r\n.autho_textarea {\r\n    display: block;\r\n    height: 2.5rem;\r\n    font-size: 0.8rem;\r\n    background: #e5ecf1;\r\n    width: 100%;\r\n    padding-left: 35px;\r\n    -webkit-transition: all 200ms ease;\r\n    -moz-transition: all 200ms ease;\r\n    -ms-transition: all 200ms ease;\r\n    -o-transition: all 200ms ease;\r\n    transition: all 200ms ease;\r\n    height: 100px;\r\n    padding-top: 17px;\r\n    margin-bottom: 0;\r\n    border: none;\r\n}\r\n\r\n    .autho_textarea:focus,\r\n    .autho_textarea:hover,\r\n    .autho_textarea:active,\r\n    .autho_textarea:focus-visible {\r\n        border-left: solid 3px #E67E22;\r\n        outline: none;\r\n    }\r\n\r\n.autho_input::-webkit-input-placeholder {\r\n    font-size: 12px !important;\r\n    font-weight: 400 !important;\r\n    font-style: italic;\r\n    color: #ababab !important;\r\n}\r\n\r\n.autho_input:-moz-placeholder {\r\n    font-size: 12px !important;\r\n    font-weight: 400 !important;\r\n    font-style: italic;\r\n    color: #ababab !important;\r\n}\r\n\r\n.autho_input::-moz-placeholder {\r\n    font-size: 12px !important;\r\n    font-weight: 400 !important;\r\n    font-style: italic;\r\n    color: #ababab !important;\r\n}\r\n\r\n.autho_input:-ms-input-placeholder {\r\n    font-size: 12px !important;\r\n    font-weight: 400 !important;\r\n    font-style: italic;\r\n    color: #ababab !important;\r\n}\r\n\r\n.autho_input::input-placeholder {\r\n    font-size: 12px !important;\r\n    font-weight: 400 !important;\r\n    font-style: italic;\r\n    color: #ababab !important;\r\n}\r\n\r\n.autho_button {\r\n    display: block;\r\n    width: 100%;\r\n    height: 2.5rem;\r\n    background: #E67E22;\r\n    border: none;\r\n    outline: none;\r\n    color: #e0e0e0;\r\n    font-size: 1rem;\r\n    font-weight: 500;\r\n    text-transform: uppercase;\r\n    letter-spacing: 0.2em;\r\n    cursor: pointer;\r\n    margin-top: 18px;\r\n}\r\n\r\n    .autho_button:hover,\r\n    .autho_button:active,\r\n    .autho_button:focus {\r\n        color: #fff;\r\n    }\r\n\r\n    .autho_button:disabled {\r\n        background: gray;\r\n    }\r\n\r\n.search_button {\r\n    display: block;\r\n    width: 100%;\r\n    height: 2.5rem;\r\n    background: #E67E22;\r\n    border: none;\r\n    outline: none;\r\n    color: #e0e0e0;\r\n    font-size: 1rem;\r\n    font-weight: 500;\r\n    text-transform: uppercase;\r\n    letter-spacing: 0.2em;\r\n    cursor: pointer;\r\n    margin-top: 30px;\r\n}\r\n\r\n    .search_button:hover {\r\n        color: #fff;\r\n    }\r\n\r\n    .search_button:disabled {\r\n        background: gray;\r\n    }\r\n\r\n.search_button_practicas {\r\n    height: 2rem;\r\n    width: 5rem;\r\n    border-radius: 0px;\r\n    font-size: 0.8rem;\r\n}\r\n\r\n.search_button_practicas:hover {\r\n   color:#fff!important;\r\n}\r\n\r\n.search_button_diagnosticos {\r\n    height: 2.5rem;\r\n    width: 2.5rem;\r\n    border-radius: 0px;\r\n    font-size: 1rem;\r\n}\r\n\r\n    .search_button_diagnosticos:hover,\r\n    .search_button_diagnosticos:active,\r\n    .search_button_diagnosticos:focus {\r\n        box-shadow: none !important;\r\n        color: #fff !important;\r\n    }\r\n\r\n.btn_square {\r\n    height: 2.5rem;\r\n    width: 2.5rem;\r\n    border-radius: 0px !important;\r\n    font-size: 1rem;\r\n    color: #e0e0e0;\r\n}\r\n\r\n    .btn_square:hover,\r\n    .btn_square:focus,\r\n    .btn_square:active,\r\n    .btn_square:focus-visible {\r\n        color: #fff !important;\r\n        outline: none;\r\n        box-shadow:none;\r\n    } \r\n\r\n    .info_form_container {\r\n        width: 100%;\r\n        background: #e5ecf1;\r\n        height: 100%;\r\n        padding-left: 20px;\r\n        padding-top: 15px;\r\n        padding-bottom: 54px;\r\n        margin-top: 10px;\r\n    }\r\n\r\n.info_form_title {\r\n    font-size: 24px;\r\n    font-weight: 600;\r\n    color: #404040;\r\n    line-height: 1.2;\r\n}\r\n\r\n.info_form {\r\n    width: 100%;\r\n    padding-right: 20px;\r\n    margin-top: 10px;\r\n}\r\n\r\n    .info_form select {\r\n        margin-bottom: 26px;\r\n    }\r\n\r\n    .info_form input:not(:last-child) {\r\n        margin-bottom: 15px;\r\n    }\r\n\r\n.info_input {\r\n    display: block;\r\n    position: relative;\r\n    width: 100%;\r\n    height: 2.5rem;\r\n    background: #FFFFFF;\r\n    padding-left: 35px;\r\n    border: none;\r\n    outline: none;\r\n}\r\n\r\n    .info_input:focus,\r\n    .info_input:hover {\r\n        border-left: solid 3px #E67E22;\r\n    }\r\n\r\n    .info_input::-webkit-input-placeholder {\r\n        font-size: 12px !important;\r\n        font-weight: 500 !important;\r\n        font-style: italic;\r\n        color: #828282 !important;\r\n    }\r\n\r\n    .info_input:-moz-placeholder {\r\n        font-size: 12px !important;\r\n        font-weight: 500 !important;\r\n        font-style: italic;\r\n        color: #828282 !important;\r\n    }\r\n\r\n    .info_input::-moz-placeholder {\r\n        font-size: 12px !important;\r\n        font-weight: 500 !important;\r\n        font-style: italic;\r\n        color: #828282 !important;\r\n    }\r\n\r\n    .info_input:-ms-input-placeholder {\r\n        font-size: 12px !important;\r\n        font-weight: 500 !important;\r\n        font-style: italic;\r\n        color: #828282 !important;\r\n    }\r\n\r\n    .info_input::input-placeholder {\r\n        font-size: 12px !important;\r\n        font-weight: 500 !important;\r\n        font-style: italic;\r\n        color: #828282 !important;\r\n    }\r\n\r\n.info_select {\r\n    display: block;\r\n    position: relative;\r\n    -webkit-appearance: none;\r\n    -moz-appearance: none;\r\n    -ms-appearance: none;\r\n    -o-appearance: none;\r\n    appearance: none;\r\n    -webkit-box-shadow: 0px 0px 0px rgba(0, 0, 0, 0);\r\n    -webkit-user-select: none;\r\n    background-image: url(../images/down.png);\r\n    background-position: center right;\r\n    background-repeat: no-repeat;\r\n    border: none;\r\n    outline: none;\r\n    font-size: 12px !important;\r\n    font-weight: 500 !important;\r\n    font-style: italic;\r\n    color: #828282 !important;\r\n    cursor: pointer;\r\n    background-color: #E67E22;\r\n}\r\n\r\n.info_form_button {\r\n    width: 100%;\r\n    height: 54px;\r\n    background: #E67E22;\r\n    border: none;\r\n    outline: none;\r\n    color: #FFFFFF;\r\n    text-transform: uppercase;\r\n    font-size: 11px;\r\n    font-weight: 600;\r\n    letter-spacing: 0.2em;\r\n    margin-top: 4px;\r\n    cursor: pointer;\r\n}\r\n\r\n.autho_info {\r\n    position: absolute;\r\n    left: 15px;\r\n    top: calc(100% + 42px);\r\n    width: calc(100% - 30px);\r\n    background: #FFFFFF;\r\n    padding-top: 33px;\r\n    padding-bottom: 62px;\r\n    border-bottom: solid 4px #E67E22;\r\n    box-shadow: 0px 71px 81px rgba(4,4,4,0.09);\r\n}\r\n\r\n.autho_info_title {\r\n    position: absolute;\r\n    top: 0;\r\n    left: 0;\r\n    font-size: 24px;\r\n    font-weight: 600;\r\n    color: #404040;\r\n    line-height: 0.75;\r\n}\r\n\r\n.autho_info_list {\r\n    margin-top: 40px;\r\n    padding-top: 58px;\r\n}\r\n\r\n    .autho_info_list ul li {\r\n        font-size: 14px;\r\n        font-weight: 500;\r\n        color: #828282;\r\n    }\r\n\r\n        .autho_info_list ul li:not(:last-child) {\r\n            margin-bottom: 16px;\r\n        }\r\n\r\n        .autho_info_list ul li span {\r\n            color: #404040;\r\n        }\r\n\r\n.tbl-practicas {\r\n    margin-bottom: 15px;\r\n    border: none;\r\n    color:black;\r\n    width: 100%;\r\n}\r\n\r\n    .tbl-practicas tr {\r\n        border: none;\r\n    }\r\n\r\n    .tbl-practicas th {\r\n        padding: .1rem;\r\n        vertical-align: top;\r\n        border: 1px solid;\r\n        padding-left: 0.5rem;\r\n        text-align: left;\r\n        font-size: 0.9rem;\r\n        border: none;\r\n        border-bottom: 1px solid black;\r\n        color: black;\r\n    }\r\n\r\n    .tbl-practicas th:first-child {\r\n        padding: .1rem;\r\n        vertical-align: top;\r\n        border: 1px solid;\r\n        /*padding-left: 0.5rem;*/\r\n        text-align: left;\r\n        font-size: 0.9rem;\r\n        border: none;\r\n        border-bottom: 1px solid black;\r\n        color: black;\r\n    }\r\n\r\n    .tbl-practicas td {\r\n        padding: .1rem;\r\n        vertical-align: middle;\r\n        border: 1px solid;\r\n        padding-left: 0.5rem;\r\n        font-size: 0.7rem;\r\n        border: none;\r\n        border-bottom: 1px solid black;\r\n        color: black;\r\n    }\r\n\r\n    .tbl-practicas td:first-child\r\n    {\r\n        padding: .1rem;\r\n        vertical-align: middle;\r\n        border: 1px solid;\r\n        /*padding-left: 0.5rem;*/        \r\n        font-size: 0.7rem;\r\n        border: none;\r\n        border-bottom: 1px solid black;\r\n        color: black;\r\n    }\r\n\r\n        .tbl-practicas td:last-child {\r\n            padding: .1rem;\r\n            vertical-align: middle;\r\n            border: 1px solid;\r\n            /*padding-left: 0.5rem;*/           \r\n            font-size: 0.7rem;\r\n            border: none;\r\n            border-bottom: 1px solid black;\r\n            color: black;\r\n            text-align:right;\r\n        }\r\n\r\n   \r\n\r\n    .tbl-practicas td > input {\r\n        margin-top:.2rem;\r\n    }\r\n\r\n    .tbl-practicas td a{\r\n        color: black;\r\n    }\r\n\r\n/*********************************\r\n8. Services\r\n*********************************/\r\n\r\n.services {\r\n    width: 100%;\r\n    background: #f4f8fb;\r\n    padding-top: 99px;\r\n    padding-bottom: 102px;\r\n}\r\n\r\n.icon_boxes_row {\r\n    margin-top: 100px;\r\n}\r\n\r\n.icon_box {\r\n    /*margin-bottom: 5px;*/\r\n}\r\n\r\n.icon_box_icon {\r\n    width: 40px;\r\n    height: 40px;\r\n}\r\n\r\n    .icon_box_icon img {\r\n        max-width: 100%;\r\n    }\r\n\r\n.icon_box_title {\r\n    font-size: 15px;\r\n    font-weight: 600;\r\n    color: #404040;\r\n    padding-left: 5px;\r\n}\r\n\r\n.icon_box_text {\r\n    font-size: 14px;\r\n    font-weight: 500;\r\n    color: #838383;\r\n    line-height: 2.14;\r\n    margin-top: 21px;\r\n}\r\n\r\n.services_button {\r\n    margin-top: 4px;\r\n}\r\n\r\n/*********************************\r\n8. Search\r\n*********************************/\r\n\r\n.search_form_container {\r\n    width: 100%;\r\n    background: #e5ecf1;\r\n    padding-left: 23px; \r\n    padding-top: 15px;\r\n    padding-bottom: 24px;\r\n    margin-top: 10px;\r\n}\r\n\r\n.search_form_title {\r\n    font-size: .875rem;\r\n    color: black;\r\n    line-height: 1.2;\r\n    font-weight:bold;\r\n}\r\n\r\n.search_input {\r\n    display: block;\r\n    position: relative;\r\n    width: 100%;\r\n    height: 1.8rem;\r\n    background: #FFFFFF;\r\n    padding-left: 10px;\r\n    border: none;\r\n    outline: none;\r\n    margin-bottom: 0px !important;\r\n    font-size: 0.8rem;\r\n    color: black;\r\n}\r\n\r\n.filter_button{\r\n    color: #e0e0e0;\r\n    background-color: #E67E22;\r\n    border-color: #E67E22;\r\n    padding: .25rem .5rem;\r\n    font-size: .875rem;\r\n    line-height: 1.5;\r\n    height: 1.8rem;\r\n    border-radius: 0px;\r\n}\r\n\r\n    .filter_button:hover,\r\n    .filter_button:active,\r\n    .filter_button:focus {\r\n        color: #fff;\r\n        box-shadow: none;\r\n    }\r\n\r\n    .search_table {\r\n        width: 100%;\r\n    }\r\n\r\n    .search_table thead th {\r\n        vertical-align: middle;\r\n        border-bottom: 2px solid #e9ecef;\r\n        width: auto;\r\n    }\r\n\r\n    .search_table tr td {\r\n        padding: .1rem;\r\n        vertical-align: top;\r\n        border: 2px solid;\r\n        /* padding-left: 0.5rem; */\r\n        text-align: center;\r\n        vertical-align: middle;\r\n    }\r\n/*********************************\r\n9. Informe\r\n*********************************/\r\n.informe {\r\n    width: 100%;\r\n    background: #FFFFFF;\r\n    padding-top: 50px;\r\n    padding-bottom: 42px;\r\n    z-index: 2;\r\n    color: black;\r\n    min-height: 536px;\r\n}\r\n\r\n.print_button {\r\n    width: 30%;\r\n    height: 2.5rem;\r\n    background: #E67E22;\r\n    border: none;\r\n    outline: none;\r\n    color: #FFFFFF;\r\n    font-size: 1rem;\r\n    font-weight: 500;\r\n    text-transform: uppercase;\r\n    letter-spacing: 0.2em;\r\n    cursor: pointer;\r\n    margin-top: 18px;\r\n    margin-right: 10%;\r\n}\r\n\r\n@media screen {\r\n    .divFooter {\r\n        display: none;\r\n    }\r\n}\r\n\r\n@media print {\r\n    .divFooter {\r\n        position: fixed;\r\n        bottom: 0;\r\n    }\r\n}\r\n\r\n/*********************************\r\n10. Footer\r\n*********************************/\r\n.footer_nav {\r\n    z-index: 2;\r\n}\r\n\r\n.footer_nav_inner {\r\n    width: 100%;\r\n}\r\n\r\n.footer_nav_container {\r\n    z-index: 1;\r\n    background: #E67E22;\r\n}\r\n\r\n.footer_nav_content {\r\n    height: 4rem;\r\n}\r\n\r\n    .footer_nav_content span {\r\n        font-size: 1rem;\r\n        font-weight: 600;\r\n        color: #fff;\r\n        vertical-align: middle;\r\n        text-align: center;\r\n        width: 100%;\r\n    }\r\n\r\n/*********************************\r\n6. Contact\r\n*********************************/\r\n\r\n.contact {\r\n    width: 100%;\r\n    background: #FFFFFF;\r\n    padding-top: 100px;\r\n    padding-bottom: 42px;\r\n    z-index: 2;\r\n}\r\n\r\n.contact_title {\r\n    font-size: 24px;\r\n    font-weight: 600;\r\n    color: #404040;\r\n    line-height: 0.75;\r\n}\r\n\r\n.contact_form_container {\r\n    margin-top: 31px;\r\n}\r\n\r\n.contact_form input:not(:last-child) {\r\n    margin-bottom: 25px;\r\n}\r\n\r\n.contact_input {\r\n    display: block;\r\n    width: 100%;\r\n    height: 51px;\r\n    background: #e5ecf1;\r\n    border: none;\r\n    outline: none;\r\n    border-left: solid 3px transparent;\r\n    padding-left: 35px;\r\n    -webkit-transition: all 200ms ease;\r\n    -moz-transition: all 200ms ease;\r\n    -ms-transition: all 200ms ease;\r\n    -o-transition: all 200ms ease;\r\n    transition: all 200ms ease;\r\n}\r\n\r\n    .contact_input:focus,\r\n    .contact_input:hover {\r\n        border-left: solid 3px #32c69a;\r\n    }\r\n\r\n.contact_textarea {\r\n    width: 100%;\r\n    height: 192px;\r\n    padding-top: 17px;\r\n    margin-bottom: 0;\r\n}\r\n\r\n.contact_input::-webkit-input-placeholder {\r\n    font-size: 12px !important;\r\n    font-weight: 400 !important;\r\n    font-style: italic;\r\n    color: #ababab !important;\r\n}\r\n\r\n.contact_input:-moz-placeholder {\r\n    font-size: 12px !important;\r\n    font-weight: 400 !important;\r\n    font-style: italic;\r\n    color: #ababab !important;\r\n}\r\n\r\n.contact_input::-moz-placeholder {\r\n    font-size: 12px !important;\r\n    font-weight: 400 !important;\r\n    font-style: italic;\r\n    color: #ababab !important;\r\n}\r\n\r\n.contact_input:-ms-input-placeholder {\r\n    font-size: 12px !important;\r\n    font-weight: 400 !important;\r\n    font-style: italic;\r\n    color: #ababab !important;\r\n}\r\n\r\n.contact_input::input-placeholder {\r\n    font-size: 12px !important;\r\n    font-weight: 400 !important;\r\n    font-style: italic;\r\n    color: #ababab !important;\r\n}\r\n\r\n.contact_button {\r\n    width: 275px;\r\n    height: 54px;\r\n    background: #32c69a;\r\n    border: none;\r\n    outline: none;\r\n    color: #FFFFFF;\r\n    font-size: 11px;\r\n    font-weight: 500;\r\n    text-transform: uppercase;\r\n    letter-spacing: 0.2em;\r\n    cursor: pointer;\r\n    margin-top: 28px;\r\n}\r\n\r\n.contact_info {\r\n    width: 100%;\r\n    background: #e5ecf1;    \r\n    padding-left: 40px;\r\n    padding-top: 15px;\r\n    padding-bottom: 54px;\r\n    margin-top: 10px;\r\n    margin-top: 30px;\r\n    border-bottom: solid 4px #E67E22;\r\n    box-shadow: 0px 71px 81px rgba(4,4,4,0.09);\r\n}\r\n\r\n.contact_info_title {\r\n    position: absolute;\r\n    top: 0;\r\n    left: 0;\r\n    font-size: 24px;\r\n    font-weight: 600;\r\n    color: #404040;\r\n    line-height: 0.75;\r\n}\r\n\r\n.contact_info_list {\r\n    margin-top: 10px;\r\n    width: 100%;\r\n}\r\n\r\n    .contact_info_list ul li {\r\n        font-size: 14px;\r\n        font-weight: 500;\r\n        color: #000;\r\n    }\r\n\r\n        .contact_info_list ul li:not(:last-child) {\r\n            margin-bottom: 16px;\r\n        }\r\n\r\n        .contact_info_list ul li span {\r\n            color: #000;\r\n            font-weight:bold;\r\n        }\r\n\r\n.contact_textarea {\r\n    display: block;\r\n    height: 2.5rem;\r\n    font-size: 0.8rem;\r\n    background: #e5ecf1;\r\n    width: 100%;\r\n    padding-left: 35px;\r\n    -webkit-transition: all 200ms ease;\r\n    -moz-transition: all 200ms ease;\r\n    -ms-transition: all 200ms ease;\r\n    -o-transition: all 200ms ease;\r\n    transition: all 200ms ease;\r\n    height: 200px;\r\n    padding-top: 17px;\r\n    margin-bottom: 0;\r\n    border: none;\r\n}\r\n\r\n.contact_mail {\r\n    color: #404040!important;\r\n}\r\n\r\n    .contact_mail:hover {\r\n        color: #E67E22 !important;\r\n    }\r\n\r\n/*********************************\r\n11. FAQ\r\n*********************************/\r\n\r\n.stuff {\r\n    width: 100%;\r\n    background: #f4f8fb;\r\n    padding-top: 99px;\r\n    padding-bottom: 104px;\r\n}\r\n\r\n.faq_title {\r\n    font-size: 36px;\r\n    font-weight: 600;\r\n    color: #404040;\r\n    line-height: 0.75;\r\n}\r\n\r\n.faq_subtitle {\r\n    font-size: 11px;\r\n    font-weight: 600;\r\n    color: #838383;\r\n    text-transform: uppercase;\r\n    letter-spacing: 0.2em;\r\n    line-height: 0.75;\r\n    margin-top: 23px;\r\n}\r\n\r\n.elements_accordions_tabs {\r\n    margin-top: 115px;\r\n}\r\n\r\n.elements_accordions {\r\n    width: 100%;\r\n}\r\n\r\n.accordions_tabs {\r\n    width: 100%;\r\n    background: #FFFFFF;\r\n    margin-top: 100px;\r\n}\r\n\r\n.accordions {\r\n    /*margin-top: 100px;*/\r\n}\r\n\r\n.accordion_container:not(:last-child) {\r\n    margin-bottom: 14px;\r\n}\r\n\r\n.accordion {\r\n    height: 2.5rem;\r\n    width: 100%;\r\n    background: #FFFFFF;\r\n    padding-left: 70px;\r\n    cursor: pointer;\r\n    color: #404040;\r\n    font-size: 14px;\r\n    font-weight: 600;\r\n    -webkit-transition: all 200ms ease;\r\n    -moz-transition: all 200ms ease;\r\n    -ms-transition: all 200ms ease;\r\n    -o-transition: all 200ms ease;\r\n    transition: all 200ms ease;\r\n    background-color: #f4f8fb;\r\n}\r\n\r\n    .accordion div {\r\n        max-width: 90%;\r\n        overflow: hidden;\r\n        white-space: nowrap;        \r\n    }\r\n\r\n    .accordion::after {\r\n        display: -webkit-box;\r\n        display: -moz-box;\r\n        display: -ms-flexbox;\r\n        display: -webkit-flex;\r\n        display: flex;\r\n        flex-direction: column;\r\n        justify-content: center;\r\n        align-items: center;\r\n        position: absolute;\r\n        top: 50%;\r\n        -webkit-transform: translateY(-50%);\r\n        -moz-transform: translateY(-50%);\r\n        -ms-transform: translateY(-50%);\r\n        -o-transform: translateY(-50%);\r\n        transform: translateY(-50%);\r\n        left: 0;\r\n        width: 50px;\r\n        height: 100%;\r\n        content: '+';\r\n        background: #E67E22;\r\n        font-size: 14px;\r\n        color: #FFFFFF;\r\n        font-weight: 500;\r\n        -webkit-transition: all 200ms ease;\r\n        -moz-transition: all 200ms ease;\r\n        -ms-transition: all 200ms ease;\r\n        -o-transition: all 200ms ease;\r\n        transition: all 200ms ease;\r\n    }\r\n\r\n    .accordion.active {\r\n        background: #E67E22;\r\n        color: #FFFFFF;\r\n    }\r\n\r\n        .accordion.active::after {\r\n            content: '-';\r\n            color: #FFFFFF;\r\n            background: #404040;\r\n        }\r\n\r\n.accordion_panel {\r\n    padding-right: 8px;\r\n    max-height: 0px;\r\n    overflow: hidden;\r\n    -webkit-transition: all 500ms ease;\r\n    -moz-transition: all 500ms ease;\r\n    -ms-transition: all 500ms ease;\r\n    -o-transition: all 500ms ease;\r\n    transition: all 500ms ease;\r\n    padding-top: 10px;\r\n}\r\n\r\n    .accordion_panel > div {\r\n        padding-bottom: 11px;\r\n    }\r\n\r\n    .accordion_panel p {\r\n        font-size: 14px;\r\n        font-weight: 500;\r\n        /*padding-top: 35px;*/\r\n        color: #838383;\r\n        line-height: 1.14;\r\n    }\r\n\r\n/*********************************\r\n12. Resolutions\r\n*********************************/\r\n@media (min-width: 400px) {\r\n    .news,\r\n    .autho,\r\n    .informe\r\n    {\r\n        min-height: 500px;\r\n    }\r\n}\r\n\r\n@media (min-width: 1920px) {\r\n    .news,\r\n    .autho,\r\n    .informe {\r\n        min-height: 660px;\r\n    }\r\n}\r\n\r\n/* Loading */\r\n.loading_save {\r\n    /*background-image: url(\"../Images/loading_save.gif\");*/\r\n    background-repeat: no-repeat;\r\n    background-position: center;\r\n    position: fixed;\r\n    top: 0px;\r\n    left: 0px;\r\n    width: 100%;\r\n    height: 100%;\r\n    z-index: 3001;\r\n    opacity: .85;\r\n    filter: alpha(opacity=85);\r\n    background-color: #faa026;\r\n}\r\n\r\n\r\n/* Badge */\r\n.badge-orange {\r\n    color: #fff;\r\n    background-color: #E67E22;\r\n}\r\n\r\n\r\n/* Border Bottom */\r\n.b-b-orange {\r\n    border-bottom: 2px solid #E67E22;\r\n}\r\n\r\n\r\n/*Modal*/\r\n.modal {\r\n    position: fixed;\r\n    top: 10%;\r\n    right: 0;\r\n    bottom: 0;\r\n    left: 0;\r\n    z-index: 1050;\r\n    display: none;\r\n    overflow: hidden;\r\n    outline: 0;\r\n}\r\n\r\n.modal-content {\r\n    /*width: max-content!important;*/\r\n}\r\n\r\n.close {   \r\n    font-size: 2.5rem!important;    \r\n}\r\n\r\n/* Error Modal*/\r\n.modal-error {\r\n    color: #434e65;\r\n    width: 525px;\r\n}\r\n\r\n    .modal-error .modal-content {\r\n        padding: 20px;\r\n        font-size: 16px;\r\n        border-radius: 5px;\r\n        border: none;\r\n    }\r\n\r\n    .modal-error .modal-header {\r\n        background: #e85e6c;\r\n        border-bottom: none;\r\n        position: relative;\r\n        text-align: center;\r\n        margin: -20px -20px 0;\r\n        border-radius: 5px 5px 0 0;\r\n        padding: 35px;\r\n    }\r\n\r\n    .modal-error h4 {\r\n        text-align: center;\r\n        font-size: 20px;\r\n        margin: 10px 0;\r\n    }\r\n\r\n    .modal-error p {\r\n        text-align: center;\r\n        font-size: 20px;\r\n        margin: 10px 0;\r\n        color: #000;\r\n    }\r\n\r\n    .modal-error .form-control, .modal-error .btn {\r\n        min-height: 40px;\r\n        border-radius: 3px;\r\n    }\r\n\r\n    .modal-error .close {\r\n        position: absolute;\r\n        top: 15px;\r\n        right: 15px;\r\n        color: #fff;\r\n        text-shadow: none;\r\n        opacity: 0.5;\r\n    }\r\n\r\n        .modal-error .close:hover {\r\n            opacity: 0.8;\r\n        }\r\n\r\n    .modal-error .icon-box {\r\n        color: #fff;\r\n        width: 95px;\r\n        height: 95px;\r\n        display: inline-block;\r\n        border-radius: 50%;\r\n        z-index: 9;\r\n        border: 5px solid #fff;\r\n        padding: 15px;\r\n        text-align: center;\r\n    }\r\n\r\n        .modal-error .icon-box i {\r\n            font-size: 58px;\r\n            margin: -2px 0 0 -2px;\r\n        }\r\n\r\n    .modal-error.modal-dialog {\r\n        margin-top: 80px;\r\n    }\r\n\r\n\r\n.modal-error-btn {\r\n    display: initial;\r\n    align-content: center;\r\n    width: 50%;\r\n    height: 2.5rem;\r\n    background: #e85e6c;\r\n    border: none;\r\n    outline: none;\r\n    color: #e0e0e0;\r\n    font-size: 1rem;\r\n    font-weight: 500;\r\n    text-transform: uppercase;\r\n    letter-spacing: 0.2em;\r\n    cursor: pointer;\r\n    margin-top: 18px;\r\n}\r\n\r\n.modal-error .modal-error-btn:hover, .modal-error .modal-error-btn:focus {\r\n    color: #fff;\r\n    border: none;\r\n    outline: none;\r\n}\r\n\r\n.trigger-btn {\r\n    display: inline-block;\r\n    margin: 100px auto;\r\n}\r\n\r\n/* Info Modal*/\r\n.modal-info {\r\n    color: #434e65;\r\n    width: 525px;\r\n}\r\n\r\n    .modal-info .modal-content {\r\n        padding: 20px;\r\n        font-size: 16px;\r\n        border-radius: 5px;\r\n        border: none;\r\n    }\r\n\r\n    .modal-info .modal-header {\r\n        background: #22B1E6;\r\n        border-bottom: none;\r\n        position: relative;\r\n        text-align: center;\r\n        margin: -20px -20px 0;\r\n        border-radius: 5px 5px 0 0;\r\n        padding: 35px;\r\n    }\r\n\r\n    .modal-info h4 {\r\n        text-align: center;\r\n        font-size: 30px;\r\n        margin: 10px 0;\r\n    }\r\n\r\n    .modal-info p {\r\n        text-align: center;\r\n        font-size: 20px;\r\n        margin: 10px 0;\r\n        color: #000;\r\n    }\r\n\r\n    .modal-info .form-control, .modal-info .btn {\r\n        min-height: 40px;\r\n        border-radius: 3px;\r\n    }\r\n\r\n    .modal-info .close {\r\n        position: absolute;\r\n        top: 15px;\r\n        right: 15px;\r\n        color: #fff;\r\n        text-shadow: none;\r\n        opacity: 0.5;\r\n    }\r\n\r\n        .modal-info .close:hover {\r\n            opacity: 0.8;\r\n        }\r\n\r\n    .modal-info .icon-box {\r\n        color: #fff;\r\n        width: 95px;\r\n        height: 95px;\r\n        display: inline-block;\r\n        /*border-radius: 50%;*/\r\n        z-index: 9;\r\n        border: 5px solid #fff;\r\n        padding: 15px;\r\n        text-align: center;\r\n    }\r\n\r\n        .modal-info .icon-box i {\r\n            font-size: 58px;\r\n            margin: -2px 0 0 -2px;\r\n        }\r\n\r\n    .modal-info.modal-dialog {\r\n        margin-top: 80px;\r\n    }\r\n\r\n\r\n.modal-info-btn {\r\n    display: initial;\r\n    align-content: center;\r\n    width: 50%;\r\n    height: 2.5rem;\r\n    background: #22B1E6;\r\n    border: none;\r\n    outline: none;\r\n    color: #e0e0e0;\r\n    font-size: 1rem;\r\n    font-weight: 500;\r\n    text-transform: uppercase;\r\n    letter-spacing: 0.2em;\r\n    cursor: pointer;\r\n    margin-top: 18px;\r\n}\r\n\r\n.modal-info .modal-info-btn:hover, .modal-info .modal-info-btn:focus {\r\n    color: #fff;\r\n    border: none;\r\n    outline: none;\r\n}\r\n\r\n.trigger-btn {\r\n    display: inline-block;\r\n    margin: 100px auto;\r\n}\r\n\r\n/* Success Modal*/\r\n.modal-success {\r\n    color: #434e65;\r\n    width: 525px;\r\n}\r\n\r\n    .modal-success .modal-content {\r\n        padding: 20px;\r\n        font-size: 16px;\r\n        border-radius: 5px;\r\n        border: none;\r\n    }\r\n\r\n    .modal-success .modal-header {\r\n        background: #1CA733;\r\n        border-bottom: none;\r\n        position: relative;\r\n        text-align: center;\r\n        margin: -20px -20px 0;\r\n        border-radius: 5px 5px 0 0;\r\n        padding: 35px;\r\n    }\r\n\r\n    .modal-success h4 {\r\n        text-align: center;\r\n        font-size: 30px;\r\n        margin: 10px 0;\r\n    }\r\n\r\n    .modal-success p {\r\n        text-align: center;\r\n        font-size: 20px;\r\n        margin: 10px 0;\r\n        color: #000;\r\n    }\r\n\r\n    .modal-success .form-control, .modal-success .btn {\r\n        min-height: 40px;\r\n        border-radius: 3px;\r\n    }\r\n\r\n    .modal-success .close {\r\n        position: absolute;\r\n        top: 15px;\r\n        right: 15px;\r\n        color: #fff;\r\n        text-shadow: none;\r\n        opacity: 0.5;\r\n    }\r\n\r\n        .modal-success .close:hover {\r\n            opacity: 0.8;\r\n        }\r\n\r\n    .modal-success .icon-box {\r\n        color: #fff;\r\n        width: 95px;\r\n        height: 95px;\r\n        display: inline-block;\r\n        /*border-radius: 50%;*/\r\n        z-index: 9;\r\n        border: 5px solid #fff;\r\n        padding: 15px;\r\n        text-align: center;\r\n    }\r\n\r\n        .modal-success .icon-box i {\r\n            font-size: 58px;\r\n            margin: -2px 0 0 -2px;\r\n        }\r\n\r\n    .modal-success.modal-dialog {\r\n        margin-top: 80px;\r\n    }\r\n\r\n\r\n.modal-success-btn {\r\n    display: initial;\r\n    align-content: center;\r\n    width: 50%;\r\n    height: 2.5rem;\r\n    background: #1CA733;\r\n    border: none;\r\n    outline: none;\r\n    color: #e0e0e0;\r\n    font-size: 1rem;\r\n    font-weight: 500;\r\n    text-transform: uppercase;\r\n    letter-spacing: 0.2em;\r\n    cursor: pointer;\r\n    margin-top: 18px;\r\n}\r\n\r\n.modal-success .modal-success-btn:hover, .modal-success .modal-success:focus {\r\n    color: #fff;\r\n    border: none;\r\n    outline: none;\r\n}\r\n\r\n.trigger-btn {\r\n    display: inline-block;\r\n    margin: 100px auto;\r\n}\r\n\r\n\r\n"
